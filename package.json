{
  "name": "starlight-glossary",
  "version": "1.1.3",
  "description": "Starlight plugin that adds an interactive glossary with hover tooltips. Driven by a single glossary.json index plus a committed Wikipedia cache — zero content-collection boilerplate.",
  "keywords": [
    "astro",
    "astro-integration",
    "astro-component",
    "starlight",
    "starlight-plugin",
    "glossary",
    "tooltip",
    "popover",
    "documentation"
  ],
  "license": "MIT",
  "author": {
    "name": "Wave RF",
    "email": "github@wave-rf.com",
    "url": "https://wave-rf.com"
  },
  "contributors": [
    "Eric Andrechek <eric@wave-rf.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Wave-RF/starlight-glossary.git"
  },
  "bugs": "https://github.com/Wave-RF/starlight-glossary/issues",
  "homepage": "https://github.com/Wave-RF/starlight-glossary#readme",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./transform": "./src/transform.ts",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@astrojs/starlight": ">=0.36.0",
    "astro": ">=5.0.0"
  },
  "dependencies": {
    "mdast-util-to-string": "^4.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.38.3",
    "@types/node": "^20.0.0",
    "astro": "^6.1.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}