{
  "name": "starlight-glossary",
  "version": "0.1.0",
  "description": "Starlight plugin that adds an interactive glossary with hover tooltips to your Astro docs site. Authors write `[term](glossary:slug)` in any page, the plugin generates the /glossary index, a JSON data endpoint, and the client-side popover.",
  "keywords": [
    "astro",
    "astro-integration",
    "astro-component",
    "starlight",
    "starlight-plugin",
    "glossary",
    "tooltip",
    "popover",
    "documentation"
  ],
  "license": "MIT",
  "author": "Eric Andrechek <eric@wave-rf.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wave-RF/starlight-glossary.git"
  },
  "bugs": "https://github.com/Wave-RF/starlight-glossary/issues",
  "homepage": "https://github.com/Wave-RF/starlight-glossary#readme",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./transform": "./src/transform.ts",
    "./schema": "./src/schema.ts",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@astrojs/starlight": ">=0.36.0",
    "astro": ">=5.0.0"
  },
  "dependencies": {
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.38.3",
    "astro": "^6.1.5",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
