---
// /glossary — listing of every glossary term with its definition and
// Wikipedia link. Reads glossary.json + glossary-cache.json via a virtual
// module injected by the plugin.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { glossaryData } from "virtual:starlight-glossary/data";
import { buildWikipediaUrl, prettifyWikipediaTitle } from "../url";

const { terms, context } = glossaryData;

// Order by term name; apply `groupWith` so grouped entries render as
// sub-items under their parent's heading.
const entries = Object.values(terms).sort((a, b) =>
  a.term.localeCompare(b.term),
);
const primaries = entries.filter((e) => !e.groupWith);
const childrenOf = new Map<string, typeof entries>();
for (const entry of entries) {
  if (entry.groupWith) {
    const bucket = childrenOf.get(entry.groupWith) ?? [];
    bucket.push(entry);
    childrenOf.set(entry.groupWith, bucket);
  }
}

const headings = primaries.map((e) => ({
  depth: 2 as const,
  slug: e.slug,
  text: e.term,
}));
---

<StarlightPage
  frontmatter={{ title: "Glossary", description: "Technical glossary" }}
  headings={headings}
>
  <p>
    Every term referenced across the documentation, with a short definition
    and a link to further reading on Wikipedia when available.
  </p>

  {
    primaries.map((entry) => {
      const kids = childrenOf.get(entry.slug) ?? [];
      return (
        <section id={entry.slug} class="sl-glossary-entry">
          <h2 id={entry.slug}>{entry.term}</h2>
          {entry.aliases.filter((a) => a !== entry.term).length > 0 && (
            <p class="sl-glossary-entry__aliases">
              Also known as:{" "}
              {entry.aliases.filter((a) => a !== entry.term).join(", ")}
            </p>
          )}
          {entry.definition ? (
            <p>{entry.definition}</p>
          ) : (
            entry.cached && (
              <div set:html={entry.cached.extract_html} />
            )
          )}
          {entry.wikipedia && (
            <p>
              <a
                href={buildWikipediaUrl(context.wikipediaBase, entry.wikipedia)}
                target="_blank"
                rel="noreferrer"
              >
                Wikipedia: {prettifyWikipediaTitle(entry.wikipedia)}
              </a>
            </p>
          )}
          {kids.map((kid) => (
            <section id={kid.slug} class="sl-glossary-entry sl-glossary-entry--child">
              <h3 id={kid.slug}>{kid.term}</h3>
              {kid.definition ? (
                <p>{kid.definition}</p>
              ) : (
                kid.cached && <div set:html={kid.cached.extract_html} />
              )}
              {kid.wikipedia && (
                <p>
                  <a
                    href={buildWikipediaUrl(context.wikipediaBase, kid.wikipedia)}
                    target="_blank"
                    rel="noreferrer"
                  >
                    Wikipedia: {prettifyWikipediaTitle(kid.wikipedia)}
                  </a>
                </p>
              )}
            </section>
          ))}
        </section>
      );
    })
  }
</StarlightPage>

<style>
  .sl-glossary-entry {
    margin-block: 2rem;
  }
  .sl-glossary-entry__aliases {
    color: var(--sl-color-gray-3);
    font-size: 0.9rem;
    margin-top: -0.5rem;
  }
  .sl-glossary-entry--child {
    margin-left: 1.5rem;
    margin-block: 1rem;
  }
</style>
